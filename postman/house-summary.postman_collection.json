{
  "info": {
    "name": "家計簿 集計API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "month", "value": "2026-10" }
  ],
  "item": [
    {
      "name": "月ごとの収支集計",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/houses/summary/monthly?month={{month}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('対象月と収支の差額', () => { const body = pm.response.json(); pm.expect(body.month).to.eql(pm.variables.get('month')); pm.expect(body.income).to.be.a('number'); pm.expect(body.expense).to.be.a('number'); pm.expect(body.balance).to.eql(body.income - body.expense); });"
      ] } }]
    },
    {
      "name": "カテゴリ別集計",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/houses/summary/categories?month={{month}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('カテゴリ別合計の形式', () => { const rows = pm.response.json(); pm.expect(rows).to.be.an('array'); rows.forEach(row => { pm.expect(row).to.have.all.keys('type', 'category', 'totalAmount'); pm.expect(row.totalAmount).to.be.a('number'); }); });"
      ] } }]
    },
    {
      "name": "不正な月は400",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/houses/summary/monthly?month=2026-13"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ] } }]
    }
  ]
}
